{
  "name": "geoterradev/api",
  "description": "GeoterRA API - RESTful Backend for Geological Manifestations Tracking",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "symfony/uid": "^7.1",
    "zircote/swagger-php": "^6.1",
    "ext-pdo": "*",
    "proj4php/proj4php": "^2.0",
    "phpmailer/phpmailer": "^7.1",
    "vlucas/phpdotenv": "^5.6",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.23",
    "brianium/paratest": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "paratest --no-coverage",
    "test:parallel": "paratest --no-coverage",
    "test:sequential": "phpunit --no-coverage",
    "test:web": "paratest tests/Unit/DTO/ tests/Unit/Services/ tests/Unit/Platform/Web/ --no-coverage",
    "test:mobile": "paratest tests/Unit/Platform/Mobile/ --no-coverage",
    "test:all": "paratest tests/Unit/ --no-coverage",
    "test:unit": "paratest tests/Unit/ --no-coverage",
    "test:coverage": "phpunit --coverage-html coverage/ --coverage-text",
    "test:coverage:web": "phpunit tests/Unit/DTO/ tests/Unit/Services/ tests/Unit/Platform/Web/ --coverage-html coverage/web --coverage-text",
    "test:coverage:mobile": "phpunit tests/Unit/Platform/Mobile/ --coverage-html coverage/mobile --coverage-text",
    "test:watch": "phpunit --watch",
    "test:services": "paratest tests/Unit/Services/ --no-coverage",
    "test:services:web": "paratest tests/Unit/Services/ --filter 'not.*Mobile' --no-coverage",
    "test:services:mobile": "paratest tests/Unit/Services/ --filter '.*Mobile' --no-coverage",
    "test:dto": "paratest tests/Unit/DTO/ --no-coverage",
    "test:repositories": "paratest tests/Unit/Repositories/ --no-coverage",
    "test:http": "paratest tests/Unit/Http/ --no-coverage",
    "test:platform:web": "paratest tests/Unit/Platform/Web/ --no-coverage",
    "test:platform:mobile": "paratest tests/Unit/Platform/Mobile/ --no-coverage",
    "test:verbose": "paratest --verbose --no-coverage"
  },
  "config": {
    "allow-plugins": true
  }
}
