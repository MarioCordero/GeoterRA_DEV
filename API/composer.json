{
  "name": "geoterradev/api",
  "description": "GeoterRA API - RESTful Backend for Geological Manifestations Tracking",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "symfony/uid": "^7.1",
    "zircote/swagger-php": "^6.1",
    "ext-pdo": "*",
    "proj4php/proj4php": "^2.0",
    "phpmailer/phpmailer": "^7.1",
    "vlucas/phpdotenv": "^5.6",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.23",
    "brianium/paratest": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "bash tests/run-tests.sh --no-coverage",
    "test:parallel": "bash tests/run-tests.sh --no-coverage",
    "test:sequential": "TEST_RUNNER=phpunit bash tests/run-tests.sh --no-coverage",
    "test:web": "bash tests/run-tests.sh tests/Unit/DTO/ tests/Unit/Services/ tests/Unit/Platform/Web/ --no-coverage",
    "test:mobile": "bash tests/run-tests.sh tests/Unit/Platform/Mobile/ --no-coverage",
    "test:all": "bash tests/run-tests.sh tests/Unit/ --no-coverage",
    "test:unit": "bash tests/run-tests.sh tests/Unit/ --no-coverage",
    "test:coverage": "TEST_RUNNER=phpunit bash tests/run-tests.sh --coverage-html coverage/ --coverage-text",
    "test:coverage:web": "TEST_RUNNER=phpunit bash tests/run-tests.sh tests/Unit/DTO/ tests/Unit/Services/ tests/Unit/Platform/Web/ --coverage-html coverage/web --coverage-text",
    "test:coverage:mobile": "TEST_RUNNER=phpunit bash tests/run-tests.sh tests/Unit/Platform/Mobile/ --coverage-html coverage/mobile --coverage-text",
    "test:watch": "TEST_RUNNER=phpunit bash tests/run-tests.sh --watch",
    "test:services": "bash tests/run-tests.sh tests/Unit/Services/ --no-coverage",
    "test:services:web": "bash tests/run-tests.sh tests/Unit/Services/ --filter 'not.*Mobile' --no-coverage",
    "test:services:mobile": "bash tests/run-tests.sh tests/Unit/Services/ --filter '.*Mobile' --no-coverage",
    "test:dto": "bash tests/run-tests.sh tests/Unit/DTO/ --no-coverage",
    "test:repositories": "bash tests/run-tests.sh tests/Unit/Repositories/ --no-coverage",
    "test:http": "bash tests/run-tests.sh tests/Unit/Http/ --no-coverage",
    "test:platform:web": "bash tests/run-tests.sh tests/Unit/Platform/Web/ --no-coverage",
    "test:platform:mobile": "bash tests/run-tests.sh tests/Unit/Platform/Mobile/ --no-coverage",
    "test:verbose": "bash tests/run-tests.sh --verbose --no-coverage"
  },
  "config": {
    "allow-plugins": true
  }
}
